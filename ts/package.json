{
  "name": "@fvutils/trlog",
  "version": "0.0.0",
  "description": "Read trlog trace files (signals and transactions) in Node and the browser -- libtrl compiled to WebAssembly, with a TypeScript API",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fvutils/trlog.git",
    "directory": "ts"
  },
  "keywords": ["trlog", "waveform", "transactions", "trace", "webassembly"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "scripts/prepare.mjs"],
  "scripts": {
    "gen:wasm": "node scripts/build-wasm.mjs",
    "gen:expected": "cd .. && PYTHONPATH=python/src packages/python/bin/python ts/scripts/gen-expected.py -o ts/test/fixtures/expected.json",
    "prepare": "node scripts/prepare.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
